{
  "name": "traffic-markering-front",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "axios": "^1.6.0",
    "jwt-decode": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.0",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "swagger-typescript-api": "^13.0.3"
  },
  "scripts": {
    "dev": "vite --host --no-open",
    "start": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "api": "swagger-typescript-api generate -p $VITE_API_URL/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums",
    "dev-api": "swagger-typescript-api generate -p http://localhost:8090/v3/api-docs -o ./src/shared/api -n api.gen.ts --axios --union-enums"
  },
  "packageManager": "pnpm@9.15.1"
}
